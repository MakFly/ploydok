[Unit]
Description=Ploydok development edge image refresher
Requires=docker.service
After=docker.service ploydok.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=${PLOYDOK_INSTALL_DIR}
EnvironmentFile=${PLOYDOK_DATA_DIR}/.env
# The helper updates only Ploydok-owned images and verifies each one against the
# pinned GitHub Actions identity. Third-party services are never verified with
# the Ploydok identity or implicitly refreshed by this unit.
ExecStart=/usr/local/lib/ploydok/update-stack.sh
TimeoutStartSec=300
