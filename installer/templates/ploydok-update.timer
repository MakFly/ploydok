[Unit]
Description=Ploydok development edge image refresher (explicit opt-in)
Requires=ploydok.service

[Timer]
# This timer is disabled by default. It is installed only for operators who
# explicitly opt into the mutable development edge channel.
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=15s
Unit=ploydok-update.service

[Install]
WantedBy=timers.target
